# Whitelist: only the built page, its video files and the deploy workflow are published.
# build.js, site.config.js, _src, _raw and DEMO-HANDOFF.md stay local
# (the site-security gate flags them as S1 if they are served or public).
*
!.gitignore
!.github/
!.github/**
!index.html
!media/
!media/*.mp4
